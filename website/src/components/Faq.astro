---
import type { Faq } from '../data/products';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Questions' } = Astro.props;
---
<section aria-labelledby="faq-h" class="mx-auto max-w-[61.25rem]">
  <h2 id="faq-h" class="display-md">{title}</h2>
  <div class="mt-8 border-t border-border">
    {faqs.map((f) => (
      <details class="faq group border-b border-border">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.3125rem] font-semibold tracking-[-0.02em]">
          {f.q}
          <span class="faq-icon relative h-4 w-4 shrink-0 text-muted" aria-hidden="true"></span>
        </summary>
        <p class="max-w-3xl pb-7 text-[1.0625rem] text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
<style>
  details > summary::-webkit-details-marker { display: none; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; border-radius: 2px; background: currentColor; transition: transform 300ms var(--ease-out); }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon::after { transform: rotate(0deg); }
</style>
