---
import type { Faq } from '../data/products';
interface Props { faqs: Faq[]; title?: string }
const { faqs, title = 'Questions' } = Astro.props;
---
<section aria-labelledby="faq-h">
  <h2 id="faq-h" class="text-2xl font-semibold">{title}</h2>
  <div class="mt-6 divide-y divide-border border-y border-border">
    {faqs.map((f) => (
      <details class="faq group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
          {f.q}
          <span class="font-mono text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 max-w-3xl text-sm text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
<style>details > summary::-webkit-details-marker { display: none; }</style>
