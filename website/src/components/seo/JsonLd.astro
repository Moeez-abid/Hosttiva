---
// Renders one or more JSON-LD objects. Pass plain schema.org objects.
interface Props { data: Record<string, unknown> | Record<string, unknown>[] }
const items = Array.isArray(Astro.props.data) ? Astro.props.data : [Astro.props.data];
---
{items.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
