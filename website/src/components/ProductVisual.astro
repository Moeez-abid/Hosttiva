---
// Authored, animated hero visual per product line. Values are generic examples, never claims.
// Animations start when the stage scrolls in (.reveal → .in) and only run under html.motion.
import type { Product } from '../data/products';
import Icon from './Icon.astro';

interface Props { product: Product }
const { product: p } = Astro.props;

type Kind = 'servers' | 'terminal' | 'globe' | 'mail' | 'site' | 'flow' | 'game' | 'accounts' | 'build';
const BY_SLUG: Record<string, Kind> = {
  'hosting/vps': 'terminal', 'hosting/web-apps': 'terminal', 'hosting/applications': 'terminal', 'hosting/linux': 'terminal',
  'hosting/ai-vps': 'flow', 'solutions/ai-vps': 'flow', 'solutions/cloudpanel': 'terminal', 'solutions/scripts': 'terminal',
  'hosting/wordpress': 'site', 'create/wordpress': 'site', 'hosting/woocommerce': 'site', 'create/templates': 'site',
  'sell-online/store-hosting': 'site', 'sell-online/managed-ecommerce': 'site', 'solutions/ecommerce': 'site',
  'sell-online/store-launch': 'build', 'sell-online/ecommerce-care': 'site',
  'hosting/game-servers': 'game',
  'products/self-hosted-n8n': 'flow', 'solutions/n8n': 'flow', 'email/mautic': 'flow', 'solutions/crm': 'flow',
  'create/hire-inventomo': 'build', 'solutions/inventomo-web-solutions': 'build', 'agencies/custom-build': 'build',
  'products/ai-website-builder': 'build', 'create/ai-website-builder': 'build', 'email/custom-solution': 'build',
  'solutions/reseller': 'accounts', 'solutions/root-whm': 'accounts',
};
const BY_CATEGORY: Record<string, Kind> = {
  hosting: 'servers', domains: 'globe', email: 'mail', ai: 'flow', create: 'site', sell: 'site', agencies: 'accounts', solutions: 'servers',
};
const kind: Kind = BY_SLUG[p.slug] ?? BY_CATEGORY[p.category] ?? 'servers';

const flowNodes: Record<string, string[]> = {
  'email/mautic': ['Form', 'Mautic', 'Segment', 'Email'],
  'solutions/crm': ['Website', 'CRM', 'Automation', 'Team'],
  'hosting/ai-vps': ['Documents', 'Vector DB', 'Model', 'Chat'],
  'solutions/ai-vps': ['Documents', 'Vector DB', 'Model', 'Chat'],
  'products/ai-agents': ['Request', 'Agent', 'Tools', 'Reply'],
  'products/managed-ai-assistant': ['Question', 'Knowledge', 'Assistant', 'Answer'],
  'products/ai-workspace': ['Files', 'Summarise', 'Draft', 'Share'],
};
const nodes = flowNodes[p.slug] ?? ['Form', 'n8n', 'CRM', 'Email'];
const terminalLines: Record<string, [string, string][]> = {
  default: [['$', 'ssh deploy@your-server'], ['$', 'docker compose up -d'], ['✓', 'app started on :3000'], ['$', 'certbot --nginx -d app.yourbrand.com'], ['✓', 'certificate issued']],
  'hosting/applications': [['$', 'install n8n --domain flows.yourbrand.com'], ['✓', 'container running'], ['✓', 'domain connected'], ['✓', 'SSL issued']],
  'solutions/cloudpanel': [['$', 'clpctl site:add:nodejs --domainName=app.yourbrand.com'], ['✓', 'site created'], ['$', 'clpctl lets-encrypt:install:certificate'], ['✓', 'certificate issued']],
};
const lines = terminalLines[p.slug] ?? terminalLines.default;
const isStore = p.category === 'sell' || p.slug === 'hosting/woocommerce';
---
<figure class="pv reveal relative mx-auto max-w-[61.25rem] overflow-hidden" data-kind={kind} aria-label={`Illustration for ${p.name}`}>
  <div class="pv-stage">
    {kind === 'servers' && (
      <div class="srv">
        {[0, 1, 2, 3].map((i) => (
          <div class="srv-unit" style={`--i:${i}`}>
            <div class="srv-bays">{Array.from({ length: 8 }, () => <span />)}</div>
            <div class="srv-meta"><span class="srv-bar" /><span class="srv-bar short" /></div>
            <div class="srv-leds"><span class="led g" style={`--d:${i * 0.6}s`} /><span class="led b" style={`--d:${i * 0.9 + 0.3}s`} /></div>
          </div>
        ))}
      </div>
    )}

    {kind === 'terminal' && (
      <div class="term glass-dark">
        <div class="term-bar"><span /><span /><span /><em>{p.slug.includes('cloudpanel') ? 'clp' : 'ssh'} — example session</em></div>
        <ol class="term-body">
          {lines.map(([sym, text], i) => (
            <li style={`--i:${i}`}><b class:list={[sym === '✓' ? 'ok' : 'cmd']}>{sym}</b><span>{text}</span></li>
          ))}
          <li class="cursor-line" style={`--i:${lines.length}`}><b class="cmd">$</b><span class="cursor" /></li>
        </ol>
      </div>
    )}

    {kind === 'globe' && (
      <div class="globe-wrap">
        <canvas class="globe" aria-hidden="true"></canvas>
        <div class="domain-pill glass-dark"><Icon name="Search" size={16} /><span class="typed">yourbrand.com</span><em>Available?</em></div>
      </div>
    )}

    {kind === 'mail' && (
      <div class="mail">
        <div class="mail-card glass-dark">
          <div class="mail-head"><span class="avatar">H</span><div><b>hello@yourcompany.com</b><small>Inbox</small></div></div>
          {['Welcome to your new mailbox', 'Order #1042 confirmed', 'Invoice for October'].map((s, i) => (
            <div class="mail-row" style={`--i:${i}`}><span class="dot" /><span>{s}</span></div>
          ))}
        </div>
        <ul class="dns-card glass-dark">
          {['MX', 'SPF', 'DKIM', 'DMARC'].map((r, i) => (
            <li style={`--i:${i}`}><span>{r}</span><b><Icon name="CircleCheck" size={16} /></b></li>
          ))}
        </ul>
      </div>
    )}

    {kind === 'site' && (
      <div class="site glass-dark">
        <div class="site-bar"><span /><span /><span /><div class="url"><Icon name="Lock" size={11} /> yourbrand.com</div></div>
        <div class="site-body">
          <div class="blk hero" style="--i:0" />
          <div class="blk-row">
            {isStore
              ? [1, 2, 3].map((i) => <div class="blk product" style={`--i:${i}`}><span /><i /></div>)
              : [1, 2, 3].map((i) => <div class="blk card" style={`--i:${i}`} />)}
          </div>
          <div class="blk text" style="--i:4" /><div class="blk text short" style="--i:5" />
        </div>
        {isStore && <div class="cart glass-dark"><Icon name="ShoppingCart" size={16} /> <span>Order placed</span></div>}
      </div>
    )}

    {kind === 'flow' && (
      <div class="flow">
        <svg class="flow-lines" viewBox="0 0 900 200" preserveAspectRatio="none" aria-hidden="true">
          {[0, 1, 2].map((i) => <path d={`M${150 + i * 225} 100 H${300 + i * 225}`} class="wire" style={`--i:${i}`} />)}
        </svg>
        {nodes.map((n, i) => (
          <div class="node glass-dark" style={`--i:${i}; --x:${12.5 + i * 25}%`}>
            <span class="node-ic"><Icon name={['FileInput', 'Workflow', 'Database', 'Send'][i]} size={20} /></span>
            <span class="node-t"><b>{n}</b><small>{['Trigger', 'Process', 'Store', 'Deliver'][i]}</small></span>
          </div>
        ))}
        {[0, 1, 2].map((k) => <span class="packet" style={`--k:${k}`} aria-hidden="true" />)}
      </div>
    )}

    {kind === 'game' && (
      <div class="game glass-dark">
        <div class="term-bar"><span /><span /><span /><em>game panel — example</em></div>
        <ol class="term-body">
          {[['[INFO]', 'Loading world "survival"'], ['[INFO]', 'Preparing spawn area'], ['[INFO]', 'Plugins enabled'], ['[INFO]', 'Done! Server is ready'], ['[INFO]', 'Backup scheduled 04:00']].map(([t, m], i) => (
            <li style={`--i:${i}`}><b class="ok">{t}</b><span>{m}</span></li>
          ))}
        </ol>
        <div class="game-foot"><span class="led g" /> Running <span class="sep" /> <Icon name="Gamepad2" size={14} /> Separate game cluster</div>
      </div>
    )}

    {kind === 'accounts' && (
      <div class="acct glass-dark">
        <div class="acct-head"><span class="brand"><span class="brand-swap"><b>Your Agency</b><b>Client portal</b></span></span><em>white-label</em></div>
        {[['NB', 'northbay.studio', 'Business'], ['KL', 'kilnandloom.com', 'Launch'], ['OR', 'orbitlabs.dev', 'Professional'], ['MV', 'mavenclinic.pk', 'Business']].map(([a, d, pk], i) => (
          <div class="acct-row" style={`--i:${i}`}><span class="avatar">{a}</span><span class="d">{d}</span><span class="pk">{pk}</span><span class="led g" style={`--d:${i * 0.5}s`} /></div>
        ))}
      </div>
    )}

    {kind === 'build' && (
      <div class="build">
        <div class="bp glass-dark"><div class="bp-grid" />{[0, 1, 2, 3].map((i) => <div class={`bp-box b${i}`} style={`--i:${i}`} />)}<em>Design</em></div>
        <div class="build-arrow"><Icon name="ArrowRight" size={20} /></div>
        <div class="app glass-dark">{[0, 1, 2, 3].map((i) => <div class={`app-box b${i}`} style={`--i:${i}`} />)}<em>Built &amp; hosted</em></div>
      </div>
    )}
  </div>
  <figcaption class="sr-only">Illustrative example; not live data.</figcaption>
</figure>

<style>
  .pv { --c-line: rgb(255 255 255 / 0.08); --c-dim: #8a8a8a; --c-txt: #ededed; --c-ok: #3ccf6e; --c-acc: #3b9eff; }
  .pv-stage {
    position: relative; aspect-ratio: 16 / 7.2; min-height: 18rem; border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background:
      linear-gradient(var(--c-line) 1px, transparent 1px) center / 44px 44px,
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px) center / 44px 44px,
      radial-gradient(110% 90% at 50% 0%, #1a1a1a, #0a0a0a 65%, #050505);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), var(--shadow-float);
    display: grid; place-items: center; overflow: hidden; color: var(--c-txt); font-size: 0.875rem;
  }
  .glass-dark {
    background: rgb(22 22 22 / 0.72); border: 1px solid rgb(255 255 255 / 0.09); border-radius: 14px;
    -webkit-backdrop-filter: blur(16px) saturate(160%); backdrop-filter: blur(16px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 24px 60px -20px rgb(0 0 0 / 0.8);
  }
  em { font-style: normal; color: var(--c-dim); font-size: 0.75rem; }
  .led { width: 7px; height: 7px; border-radius: 999px; display: inline-block; }
  .led.g { background: var(--c-ok); box-shadow: 0 0 8px rgb(60 207 110 / 0.6); }
  .led.b { background: var(--c-acc); box-shadow: 0 0 8px rgb(59 158 255 / 0.5); }
  :global(.motion) .pv.in .led { animation: blink 2.8s ease-in-out var(--d, 0s) infinite; }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  /* Sequenced entrance for list-like parts */
  :global(.motion) .pv:not(.in) [style*='--i'] { opacity: 0; transform: translateY(10px); }
  .pv [style*='--i'] { transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out); transition-delay: calc(250ms + var(--i) * 180ms); }

  /* servers */
  .srv { width: min(74%, 34rem); display: grid; gap: 10px; transform: perspective(1200px) rotateX(18deg) rotateY(-14deg); transform-style: preserve-3d; }
  .srv-unit { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 10px; background: linear-gradient(#232323, #191919); border: 1px solid #333; box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.8); }
  .srv-bays { display: flex; gap: 5px; flex: 1; }
  .srv-bays span { flex: 1; height: 22px; border-radius: 3px; background: #0d0d0d; border: 1px solid #2a2a2a; }
  .srv-meta { display: grid; gap: 5px; width: 22%; }
  .srv-bar { height: 4px; border-radius: 2px; background: #2e2e2e; }
  .srv-bar.short { width: 60%; }
  .srv-leds { display: flex; gap: 6px; }
  :global(.motion) .pv.in .srv { animation: float 7s ease-in-out infinite; }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }

  /* terminal & game */
  .term, .game { width: min(86%, 40rem); text-align: left; overflow: hidden; }
  .term-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
  .term-bar span { width: 10px; height: 10px; border-radius: 999px; background: #3a3a3a; }
  .term-bar em { margin-left: 8px; }
  .term-body { padding: 16px 18px; display: grid; gap: 8px; font-family: var(--font-mono); font-size: 0.8125rem; }
  .term-body li { display: flex; gap: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .term-body b { font-weight: 500; flex: none; }
  .term-body .cmd { color: var(--c-dim); }
  .term-body .ok { color: var(--c-ok); }
  .cursor { width: 8px; height: 1.05em; background: var(--c-txt); display: inline-block; }
  :global(.motion) .pv.in .cursor { animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .game-foot { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-top: 1px solid rgb(255 255 255 / 0.07); color: var(--c-dim); font-size: 0.8125rem; }
  .game-foot .sep { width: 1px; height: 12px; background: #333; margin-inline: 6px; }

  /* globe */
  .globe-wrap { position: absolute; inset: 0; display: grid; place-items: center; }
  .globe { position: absolute; left: 50%; top: 34%; translate: -50% 0; width: min(78%, 40rem); aspect-ratio: 1; }
  .domain-pill { position: absolute; top: 14%; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 999px; font-size: 1rem; color: var(--c-txt); }
  .domain-pill em { margin-left: 6px; color: var(--c-acc); font-size: 0.8125rem; }
  .typed { display: inline-block; overflow: hidden; white-space: nowrap; border-right: 2px solid transparent; }
  :global(.motion) .pv.in .typed { animation: type 1.6s steps(13) 500ms both; }
  @keyframes type { from { width: 0; } to { width: 13ch; } }

  /* mail */
  .mail { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; width: min(86%, 42rem); align-items: center; }
  .mail-card { padding: 16px; display: grid; gap: 10px; }
  .mail-head { display: flex; gap: 10px; align-items: center; padding-bottom: 8px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
  .mail-head small { display: block; color: var(--c-dim); font-size: 0.75rem; }
  .avatar { width: 30px; height: 30px; border-radius: 9px; background: #0071e3; display: grid; place-items: center; font-weight: 600; color: #fff; flex: none; font-size: 0.75rem; }
  .mail-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; background: rgb(255 255 255 / 0.03); }
  .mail-row .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--c-acc); flex: none; }
  .dns-card { padding: 14px; display: grid; gap: 8px; }
  .dns-card li { display: flex; justify-content: space-between; align-items: center; padding: 6px 4px; font-family: var(--font-mono); font-size: 0.8125rem; }
  .dns-card b { color: var(--c-ok); display: flex; }

  /* site */
  .site { width: min(82%, 40rem); overflow: hidden; position: relative; }
  .site-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
  .site-bar > span { width: 10px; height: 10px; border-radius: 999px; background: #3a3a3a; }
  .url { margin-left: 10px; flex: 1; display: flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 6px; background: rgb(255 255 255 / 0.05); color: var(--c-dim); font-size: 0.75rem; }
  .site-body { padding: 16px; display: grid; gap: 12px; }
  .blk { border-radius: 8px; background: rgb(255 255 255 / 0.06); }
  .blk.hero { height: 72px; background: linear-gradient(90deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.04)); }
  .blk-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .blk.card { height: 64px; }
  .blk.product { height: 78px; display: grid; grid-template-rows: 1fr auto; padding: 8px; gap: 6px; }
  .blk.product span { border-radius: 6px; background: rgb(255 255 255 / 0.08); }
  .blk.product i { height: 6px; width: 50%; border-radius: 3px; background: var(--c-acc); opacity: 0.8; }
  .blk.text { height: 10px; width: 70%; }
  .blk.text.short { width: 45%; }
  .cart { position: absolute; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; font-size: 0.8125rem; color: var(--c-ok); }
  :global(.motion) .pv.in .cart { animation: pop 600ms var(--ease-out) 1.8s both; }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(0.95); } }

  /* flow */
  .flow { position: absolute; inset: 0; }
  .flow-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wire { stroke: rgb(255 255 255 / 0.18); stroke-width: 2; fill: none; stroke-dasharray: 6 8; vector-effect: non-scaling-stroke; }
  :global(.motion) .pv.in .wire { animation: dash 1.4s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -28; } }
  .node { position: absolute; top: 50%; left: var(--x); transform: translate(-50%, -50%); display: flex; align-items: center; gap: 12px; padding: 14px 18px 14px 14px; white-space: nowrap; z-index: 1; }
  .node-ic { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.08); color: var(--c-acc); }
  .node-t b { display: block; font-size: 1rem; font-weight: 600; }
  .node-t small { display: block; color: var(--c-dim); font-size: 0.75rem; }
  .packet { position: absolute; top: 50%; left: 12.5%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 999px; background: var(--c-acc); box-shadow: 0 0 12px rgb(59 158 255 / 0.8); opacity: 0; }
  :global(.motion) .pv.in .packet { animation: travel 4.5s cubic-bezier(0.45, 0, 0.55, 1) calc(1.2s + var(--k) * 1.5s) infinite; }
  @keyframes travel { 0% { left: 12.5%; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { left: 87.5%; opacity: 0; } }
  :global(.motion) .pv:not(.in) .node { transform: translate(-50%, calc(-50% + 10px)); }
  

  /* accounts */
  .acct { width: min(80%, 36rem); padding: 14px; display: grid; gap: 8px; }
  .acct-head { display: flex; justify-content: space-between; align-items: center; padding: 4px 4px 10px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
  .brand { height: 1.3em; overflow: hidden; display: block; }
  .brand-swap { display: grid; }
  :global(.motion) .pv.in .brand-swap { animation: swap 5s var(--ease-out) 1.5s infinite; }
  @keyframes swap { 0%, 40% { transform: translateY(0); } 50%, 90% { transform: translateY(-50%); } 100% { transform: translateY(0); } }
  .acct-row { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 12px; padding: 8px 6px; border-radius: 8px; background: rgb(255 255 255 / 0.03); }
  .acct-row .avatar { width: 26px; height: 26px; font-size: 0.6875rem; background: #2a2a2a; }
  .acct-row .d { font-family: var(--font-mono); font-size: 0.8125rem; }
  .acct-row .pk { color: var(--c-dim); font-size: 0.75rem; }

  /* build */
  .build { display: flex; align-items: center; gap: 18px; width: min(88%, 44rem); }
  .bp, .app { flex: 1; aspect-ratio: 4 / 3; position: relative; padding: 14px; display: grid; grid-template: 'a a' 1.2fr 'b c' 1fr 'd d' 0.4fr / 1fr 1fr; gap: 8px; }
  .bp em, .app em { position: absolute; left: 12px; bottom: -26px; }
  .bp-grid { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(rgb(59 158 255 / 0.12) 1px, transparent 1px) 0 0 / 14px 14px, linear-gradient(90deg, rgb(59 158 255 / 0.12) 1px, transparent 1px) 0 0 / 14px 14px; }
  .bp-box { border: 1.5px dashed rgb(59 158 255 / 0.55); border-radius: 6px; position: relative; }
  .app-box { border-radius: 6px; background: rgb(255 255 255 / 0.08); }
  .b0 { grid-area: a; } .b1 { grid-area: b; } .b2 { grid-area: c; } .b3 { grid-area: d; }
  .app-box.b0 { background: linear-gradient(90deg, #0071e3, #3b9eff); opacity: 0.85; }
  .build-arrow { color: var(--c-dim); flex: none; }
  .app .app-box { transition-delay: calc(900ms + var(--i) * 180ms); }

  @media (max-width: 640px) {
    .pv-stage { aspect-ratio: 4 / 5; }
    .mail { grid-template-columns: 1fr; }
    .node { padding: 10px 14px 10px 10px; } .node-ic { width: 32px; height: 32px; } .packet { display: none; }
    .flow .node { left: 50%; top: calc(18% + var(--i) * 21%); }
    .flow-lines { display: none; }
    .build { flex-direction: column; gap: 34px; }
    .bp, .app { width: 100%; }
    .build-arrow { transform: rotate(90deg); }
    .srv { width: 86%; }
  }
</style>

<script>
  // Rotating dot globe for the domains visual (canvas 2D, ~1k points, pauses off-screen).
  function initGlobes() {
    document.querySelectorAll<HTMLCanvasElement>('.pv canvas.globe').forEach((c) => {
      if (c.dataset.bound) return;
      c.dataset.bound = '1';
      const ctx = c.getContext('2d');
      if (!ctx) return;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const N = 1400;
      const pts = Array.from({ length: N }, (_, i) => {
        const y = 1 - (i / (N - 1)) * 2;
        const r = Math.sqrt(1 - y * y);
        const th = i * Math.PI * (3 - Math.sqrt(5));
        return [Math.cos(th) * r, y, Math.sin(th) * r];
      });
      let rot = 0, raf = 0, on = false;
      const draw = () => {
        const dpr = Math.min(devicePixelRatio, 2);
        const w = c.clientWidth, h = c.clientHeight;
        if (c.width !== w * dpr) { c.width = w * dpr; c.height = h * dpr; }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const R = w * 0.46, cx = w / 2, cy = h / 2, tilt = 0.35;
        const s = Math.sin(rot), co = Math.cos(rot), st = Math.sin(tilt), ct = Math.cos(tilt);
        for (const [x, y, z] of pts) {
          const x1 = x * co - z * s, z1 = x * s + z * co;
          const y2 = y * ct - z1 * st, z2 = y * st + z1 * ct;
          if (z2 < -0.15) continue;
          const a = 0.15 + 0.85 * Math.max(0, (z2 + 0.15) / 1.15);
          ctx.fillStyle = `rgba(237,237,237,${(0.1 + a * 0.8).toFixed(3)})`;
          ctx.fillRect(cx + x1 * R, cy - y2 * R, 2, 2);
        }
        // Accent "connected" points
        [[0.3, 0.55, 0.78], [-0.45, 0.6, 0.66], [0.62, 0.35, 0.7], [-0.1, 0.8, 0.59]].forEach(([x, y, z]) => {
          const x1 = x * co - z * s, z1 = x * s + z * co;
          const y2 = y * ct - z1 * st, z2 = y * st + z1 * ct;
          if (z2 < 0) return;
          ctx.fillStyle = '#3b9eff';
          ctx.beginPath(); ctx.arc(cx + x1 * R, cy - y2 * R, 3.5, 0, Math.PI * 2); ctx.fill();
        });
        if (!reduced) rot += 0.0035;
        if (on && !reduced) raf = requestAnimationFrame(draw);
      };
      const io = new IntersectionObserver(([e]) => {
        on = e.isIntersecting;
        cancelAnimationFrame(raf);
        if (on) raf = requestAnimationFrame(draw);
      });
      io.observe(c);
      draw();
    });
  }
  document.addEventListener('astro:page-load', initGlobes);
</script>
