---
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORIES } from '../content.config';
interface Props { posts: CollectionEntry<'blog'>[] }
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<ul class="divide-y divide-border border-y border-border">
  {Astro.props.posts.map((p) => (
    <li>
      <a href={`/blog/${p.id}`} class="group grid gap-2 py-6 sm:grid-cols-[9rem_1fr]">
        <span class="spec">
          <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
          <span class="block text-faint">{BLOG_CATEGORIES[p.data.category]}</span>
        </span>
        <span>
          <span class="font-display text-xl font-medium group-hover:text-accent">{p.data.title}</span>
          <span class="mt-1 block text-sm text-muted">{p.data.description}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
