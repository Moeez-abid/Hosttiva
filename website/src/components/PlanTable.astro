---
// Plan comparison in Apple "compare models" form: one column per plan, price first, renewal directly beneath.
import Icon from './Icon.astro';
import { LINKS } from '../config/site';
import { formatPrice, PRICES_ARE_PLACEHOLDERS, type PlanGroup, type Term } from '../data/plans';
interface Props { group: PlanGroup; headingLevel?: 'h2' | 'h3' }
const { group, headingLevel: H = 'h2' } = Astro.props;
const terms: Term[] = ['annual', 'monthly'];
---
<section data-pagefind-ignore class="plan-group scroll-mt-32" id={`plans-${group.id}`} aria-labelledby={`plans-${group.id}-h`}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <H id={`plans-${group.id}-h`} class="display-md">{group.name}</H>
      <p class="mt-2 text-[1.0625rem] text-muted">{group.intro}</p>
    </div>
    {PRICES_ARE_PLACEHOLDERS && <span class="badge badge-warn" title="Prices are drafts and will change before launch">Draft prices</span>}
  </div>

  <ul class="plans mt-10 grid snap-x snap-mandatory auto-cols-[78%] grid-flow-col gap-4 overflow-x-auto pb-2 sm:auto-cols-[45%] lg:grid-flow-row lg:grid-cols-4 lg:overflow-visible">
    {group.plans.map((plan) => (
      <li class:list={['plan flex snap-start flex-col rounded-[var(--radius-xl)] p-7', plan.featured ? 'plan-featured bg-raised' : 'bg-transparent']}>
        <div class="flex min-h-7 items-center gap-2">
          <h3 class="title !text-[1.5rem]">{plan.name}</h3>
          {plan.featured && <span class="badge badge-accent">Popular</span>}
        </div>
        {plan.fit && <p class="mt-1 min-h-[2.75rem] text-[0.875rem] text-muted">{plan.fit}</p>}

        <div class="mt-5 min-h-[5.5rem] tabular">
          {plan.price ? terms.map((t) => (
            <div data-term={t}>
              <p class="text-[2.25rem] font-semibold leading-none tracking-[-0.03em]">{formatPrice(plan.price![t].promo)}<span class="text-[1rem] font-normal tracking-normal text-muted">/mo</span></p>
              <p class="mt-2 text-[0.875rem] text-muted">Renews at <strong class="font-semibold text-text">{formatPrice(plan.price![t].renewal)}/mo</strong></p>
              <p class="text-[0.8125rem] text-muted">{t === 'annual' ? 'Billed annually' : 'Billed monthly'}</p>
            </div>
          )) : (
            <>
              <p class="text-[2.25rem] font-semibold leading-none tracking-[-0.03em]">Custom</p>
              <p class="mt-2 text-[0.875rem] text-muted">Quoted for your workload</p>
            </>
          )}
        </div>

        {plan.price
          ? <a href={LINKS.order(plan.pid, group.whmcsGroup)} class:list={['btn btn-sm mt-6 self-start !px-5 !py-2 !text-[0.9375rem]', plan.featured ? 'btn-primary' : 'btn-secondary']} aria-label={`Choose ${plan.name}`}>Choose {plan.name}</a>
          : <a href={LINKS.enquiry(`${group.name}: ${plan.name}`)} class="btn btn-secondary btn-sm mt-6 self-start !px-5 !py-2 !text-[0.9375rem]">Request a quote</a>}

        <ul class="mt-7 space-y-3 border-t border-border pt-6 text-[0.9375rem]">
          {plan.features.map((f) => (
            <li class="flex items-start gap-2.5"><Icon name="Check" size={16} class="mt-0.5 shrink-0 text-link" />{f}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  {group.note && <p class="mt-4 text-[0.8125rem] text-muted">{group.note}</p>}
</section>

<style>
  .plans { scrollbar-width: none; }
  .plans::-webkit-scrollbar { display: none; }
  .plan:not(.plan-featured) { box-shadow: inset 0 0 0 1px var(--border); }
</style>
