---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { PRODUCTS_MENU, SOLUTIONS_MENU, RESOURCES_MENU } from '../config/nav';
import { LINKS, PRELAUNCH } from '../config/site';

const path = Astro.url.pathname;
const active = (prefixes: string[]) => prefixes.some((p) => path.startsWith(p));
const menus = [
  { id: 'products', label: 'Products', active: active(['/products', '/hosting', '/domains', '/create', '/sell-online', '/email', '/agencies']) },
  { id: 'solutions', label: 'Solutions', active: active(['/solutions', '/marketplace']) },
  { id: 'resources', label: 'Resources', active: active(['/blog', '/tutorials', '/contact', '/about', '/roadmap', '/customer-success']) },
];
// Large "explore" links lead each flyout, Apple-style.
const explore = {
  products: [
    { label: 'Hosting', href: '/hosting/web' },
    { label: 'Cloud & VPS', href: '/hosting/vps' },
    { label: 'Domains', href: '/domains/search' },
    { label: 'Email', href: '/email/business' },
    { label: 'Compare plans', href: '/pricing' },
  ],
  solutions: [
    { label: 'Marketplace', href: '/marketplace' },
    { label: 'For agencies', href: '/agencies' },
    { label: 'Custom builds', href: '/agencies/custom-build' },
  ],
  resources: [
    { label: 'Blog', href: '/blog' },
    { label: 'Tutorials', href: '/tutorials' },
    { label: 'Contact', href: '/contact' },
  ],
};
---
<header class="site-header sticky top-0 z-50">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 btn btn-primary btn-sm z-10">Skip to content</a>
  <div class="bar glass !border-x-0 !border-t-0">
    <div class="container-x flex h-[var(--header-h)] items-center gap-2">
      <Logo />

      <nav aria-label="Main" class="mx-auto hidden lg:block">
        <ul class="flex items-center">
          {menus.map((m) => (
            <li>
              <button
                type="button"
                class:list={['nav-trigger rounded-full px-3.5 py-1.5 text-[0.875rem] leading-normal transition-colors', m.active ? 'text-text' : 'text-text/80 hover:text-text']}
                aria-expanded="false"
                aria-controls={`menu-${m.id}`}
              >{m.label}</button>
            </li>
          ))}
          <li>
            <a href="/pricing" class:list={['inline-block rounded-full px-3.5 py-1.5 text-[0.875rem] leading-normal transition-colors', path.startsWith('/pricing') ? 'text-text' : 'text-text/80 hover:text-text']}>Pricing</a>
          </li>
          <li>
            <a href="/trust" class:list={['inline-block rounded-full px-3.5 py-1.5 text-[0.875rem] leading-normal transition-colors', path.startsWith('/trust') ? 'text-text' : 'text-text/80 hover:text-text']}>Trust</a>
          </li>
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 lg:ml-0">
        <a href="/search" class="icon-btn" aria-label="Search" title="Search"><Icon name="Search" size={17} /></a>
        <ThemeToggle />
        {!PRELAUNCH && <a href={LINKS.clientArea} class="hidden px-3 text-[0.875rem] text-text/80 hover:text-text sm:inline">Client area</a>}
        <a href="/pricing" class="btn btn-primary btn-sm ml-1 hidden sm:inline-flex">Get started</a>
        <button type="button" class="mobile-toggle icon-btn lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Desktop flyouts -->
  <div class="flyouts hidden lg:block">
    <div id="menu-products" class="flyout glass !border-x-0 !border-t-0" hidden>
      <div class="container-x grid grid-cols-[13rem_1fr] gap-12 pb-12 pt-9">
        <div>
          <p class="label mb-4">Explore</p>
          <ul class="space-y-2.5">{explore.products.map((l) => <li><a href={l.href} class="text-2xl font-semibold tracking-tight hover:text-link">{l.label}</a></li>)}</ul>
        </div>
        <div class="columns-4 gap-8">
          {PRODUCTS_MENU.map((cat) => (
            <div class="mb-7 break-inside-avoid">
              <p class="label mb-2.5">{cat.label}</p>
              <ul class="space-y-1.5">
                {cat.items.map((it) => (
                  <li>
                    <a href={it.href} class="flex items-center gap-2 text-[0.8125rem] font-semibold text-text/85 hover:text-link">
                      {it.label}{it.soon && <span class="text-[0.6875rem] font-normal text-muted">Soon</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="menu-solutions" class="flyout glass !border-x-0 !border-t-0" hidden>
      <div class="container-x grid grid-cols-[13rem_1fr] gap-12 pb-12 pt-9">
        <div>
          <p class="label mb-4">Explore</p>
          <ul class="space-y-2.5">{explore.solutions.map((l) => <li><a href={l.href} class="text-2xl font-semibold tracking-tight hover:text-link">{l.label}</a></li>)}</ul>
        </div>
        <ul class="grid grid-cols-3 gap-x-8 gap-y-5">
          {SOLUTIONS_MENU.map((it) => (
            <li>
              <a href={it.href} class="group block">
                <span class="block text-[0.875rem] font-semibold group-hover:text-link">{it.label}</span>
                <span class="mt-0.5 block text-[0.8125rem] leading-snug text-muted">{it.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div id="menu-resources" class="flyout glass !border-x-0 !border-t-0" hidden>
      <div class="container-x grid grid-cols-[13rem_1fr] gap-12 pb-12 pt-9">
        <div>
          <p class="label mb-4">Explore</p>
          <ul class="space-y-2.5">{explore.resources.map((l) => <li><a href={l.href} class="text-2xl font-semibold tracking-tight hover:text-link">{l.label}</a></li>)}</ul>
        </div>
        <ul class="grid grid-cols-3 gap-x-8 gap-y-5">
          {RESOURCES_MENU.map((it) => (
            <li>
              <a href={it.href} class="group block">
                <span class="flex items-center gap-2 text-[0.875rem] font-semibold group-hover:text-link">{it.label}{it.soon && <span class="text-[0.6875rem] font-normal text-muted">Soon</span>}</span>
                <span class="mt-0.5 block text-[0.8125rem] leading-snug text-muted">{it.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <!-- Mobile sheet -->
  <div id="mobile-nav" class="sheet glass lg:hidden" hidden>
    <nav aria-label="Mobile" class="container-x pb-10 pt-4">
      {[{ id: 'products', label: 'Products', items: PRODUCTS_MENU.flatMap((c) => c.items) }, { id: 'solutions', label: 'Solutions', items: SOLUTIONS_MENU }, { id: 'resources', label: 'Resources', items: RESOURCES_MENU }].map((g) => (
        <details class="group border-b border-border">
          <summary class="flex cursor-pointer items-center justify-between py-4 text-[1.75rem] font-semibold tracking-tight">
            {g.label}
            <Icon name="ChevronDown" size={20} class="text-muted transition-transform group-open:rotate-180" />
          </summary>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 pb-5">
            {g.items.map((it) => <li><a href={it.href} class="text-[0.9375rem] font-medium text-text/85">{it.label}</a></li>)}
          </ul>
        </details>
      ))}
      <a href="/pricing" class="block border-b border-border py-4 text-[1.75rem] font-semibold tracking-tight">Pricing</a>
      <a href="/trust" class="block border-b border-border py-4 text-[1.75rem] font-semibold tracking-tight">Trust</a>
      <div class="mt-6 flex gap-3">
        {PRELAUNCH ? <a href="/contact" class="btn btn-quiet flex-1">Contact</a> : <a href={LINKS.clientArea} class="btn btn-quiet flex-1">Client area</a>}
        <a href="/pricing" class="btn btn-primary flex-1">Get started</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .bar { position: relative; z-index: 2; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border-radius: 999px;
    color: color-mix(in srgb, var(--text) 80%, transparent);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  @media (min-width: 1024px) { .mobile-toggle { display: none; } }
  .icon-btn:hover { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .nav-trigger[aria-expanded='true'] { color: var(--text); background: color-mix(in srgb, var(--text) 7%, transparent); }

  .flyouts { position: absolute; inset-inline: 0; top: 100%; z-index: 2; }
  .flyout {
    background: var(--glass-strong);
    animation: flyout 320ms var(--ease-out);
    transform-origin: top;
  }
  @keyframes flyout {
    from { opacity: 0; clip-path: inset(0 0 100% 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }
  /* Menu items cascade in */
  :global(.motion) .flyout li { animation: fly-item 460ms var(--ease-out) both; }
  .flyout li:nth-child(1) { animation-delay: 22ms; }
  .flyout li:nth-child(2) { animation-delay: 44ms; }
  .flyout li:nth-child(3) { animation-delay: 66ms; }
  .flyout li:nth-child(4) { animation-delay: 88ms; }
  .flyout li:nth-child(5) { animation-delay: 110ms; }
  .flyout li:nth-child(6) { animation-delay: 132ms; }
  .flyout li:nth-child(7) { animation-delay: 154ms; }
  .flyout li:nth-child(8) { animation-delay: 176ms; }
  .flyout li:nth-child(9) { animation-delay: 198ms; }
  .flyout li:nth-child(10) { animation-delay: 220ms; }
  .flyout li:nth-child(11) { animation-delay: 242ms; }
  .flyout li:nth-child(12) { animation-delay: 264ms; }
  .flyout li:nth-child(13) { animation-delay: 286ms; }
  .flyout li:nth-child(14) { animation-delay: 308ms; }
  @keyframes fly-item { from { opacity: 0; transform: translate3d(0, -6px, 0); filter: blur(3px); } }
  /* Blurs the page behind an open flyout */
  .scrim {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 1;
    background: rgb(0 0 0 / 0.08);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    opacity: 0; pointer-events: none;
    transition: opacity 320ms var(--ease-out);
  }
  .site-header.menu-open .scrim { opacity: 1; pointer-events: auto; }

  .sheet {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 3;
    background: var(--glass-strong); overflow-y: auto; border: 0;
    animation: flyout 320ms var(--ease-out);
  }
  .burger { position: relative; width: 17px; height: 10px; display: block; }
  .burger span { position: absolute; left: 0; right: 0; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform 300ms var(--ease-out), top 300ms var(--ease-out); }
  .burger span:first-child { top: 1px; }
  .burger span:last-child { top: 7.5px; }
  .mobile-toggle[aria-expanded='true'] .burger span:first-child { top: 4.25px; transform: rotate(45deg); }
  .mobile-toggle[aria-expanded='true'] .burger span:last-child { top: 4.25px; transform: rotate(-45deg); }
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
</style>

<script>
  let ctrl: AbortController | undefined;
  function initHeader() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;

    const triggers = [...header.querySelectorAll<HTMLButtonElement>('.nav-trigger')];
    const closeAll = () => {
      triggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = true;
      });
      header.classList.remove('menu-open');
    };
    const open = (t: HTMLButtonElement) => {
      triggers.forEach((o) => { if (o !== t) { o.setAttribute('aria-expanded', 'false'); document.getElementById(o.getAttribute('aria-controls')!)!.hidden = true; } });
      t.setAttribute('aria-expanded', 'true');
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = false;
      header.classList.add('menu-open');
    };

    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let openedAt = 0;
    triggers.forEach((t) => {
      t.addEventListener('click', () => {
        const isOpen = t.getAttribute('aria-expanded') === 'true';
        // Ignore the click that immediately follows a hover-open.
        if (isOpen && !(canHover && Date.now() - openedAt < 400)) closeAll();
        else open(t);
      });
    });

    if (canHover) {
      let timer: number | undefined;
      triggers.forEach((t) => t.parentElement!.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        if (t.getAttribute('aria-expanded') !== 'true') { openedAt = Date.now(); open(t); }
      }));
      const zone = [header.querySelector('.bar')!, header.querySelector('.flyouts')!];
      zone.forEach((z) => {
        z.addEventListener('mouseleave', () => { timer = window.setTimeout(closeAll, 180); });
        z.addEventListener('mouseenter', () => clearTimeout(timer));
      });
    }

    header.querySelector('.scrim')!.addEventListener('click', closeAll);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); }, { signal });

    const mobileBtn = header.querySelector<HTMLButtonElement>('.mobile-toggle')!;
    const sheet = document.getElementById('mobile-nav')!;
    mobileBtn.addEventListener('click', () => {
      const isOpen = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!isOpen));
      mobileBtn.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      sheet.hidden = isOpen;
      document.documentElement.style.overflow = isOpen ? '' : 'hidden';
    });
  }
  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:before-swap', () => { document.documentElement.style.overflow = ''; });
</script>
