---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PostList from './PostList.astro';
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES } from '../content.config';
import { breadcrumbs } from '../lib/schema';
type Cat = keyof typeof BLOG_CATEGORIES;
interface Props { category?: Cat }
const { category } = Astro.props;
const all = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const posts = category ? all.filter((p) => p.data.category === category) : all;
const used = new Set(all.map((p) => p.data.category));
const title = category ? BLOG_CATEGORIES[category] : 'Blog';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, ...(category ? [{ name: title, path: `/blog/category/${category}` }] : [])];
---
<Base title={category ? `${title} articles` : 'Blog'} description={category ? `Hosttiva articles about ${title.toLowerCase()}.` : 'Expert tips, product updates, and customer stories from Hosttiva by Inventomo.'} schema={[breadcrumbs(crumbs)]}>
  <section class="container-x py-14 sm:py-20">
    <Breadcrumbs items={crumbs} />
    <h1 class="display-lg mt-8 max-w-4xl" data-split="now">{category ? title : 'Notes from the people who run the servers'}</h1>
    {!category && <p class="lead enter mt-5 max-w-2xl" style="--d:320ms">Expert tips, product updates, and customer stories.</p>}
    <nav aria-label="Categories" class="mt-8 flex flex-wrap gap-2 text-sm">
      <a href="/blog" class:list={['rounded-full border px-3 py-1', !category ? 'border-accent text-accent' : 'border-border text-muted hover:text-text']}>All</a>
      {(Object.keys(BLOG_CATEGORIES) as Cat[]).filter((c) => used.has(c)).map((c) => (
        <a href={`/blog/category/${c}`} class:list={['rounded-full border px-3 py-1', category === c ? 'border-accent text-accent' : 'border-border text-muted hover:text-text']}>{BLOG_CATEGORIES[c]}</a>
      ))}
    </nav>
    <div class="mt-10"><PostList posts={posts} /></div>
  </section>
</Base>
