---
// Shared frame for client-side free tools.
interface Props { id: string; label: string; placeholder: string; button: string; privacy: string }
const { id, label, placeholder, button, privacy } = Astro.props;
---
<div class="tool tile mx-auto max-w-[61.25rem] overflow-hidden text-left" data-tool={id}>
  <form class="tool-form flex flex-col gap-3 p-4 sm:flex-row sm:items-end sm:p-5" novalidate>
    <label class="flex-1">
      <span class="label block pb-1.5 pl-1">{label}</span>
      <input name="q" type="text" required autocomplete="off" spellcheck="false" inputmode="url" placeholder={placeholder} class="field !bg-surface" />
    </label>
    <slot name="controls" />
    <button type="submit" class="btn btn-primary">{button}</button>
  </form>
  <div class="tool-out mx-4 mb-4 min-h-28 rounded-[var(--radius-lg)] bg-surface p-5 text-[0.9375rem] sm:mx-5 sm:mb-5" aria-live="polite">
    <p class="text-muted">Results appear here.</p>
  </div>
  <p class="px-5 pb-5 text-[0.8125rem] text-muted">{privacy}</p>
</div>
