---
// Monthly / annual switch: an Apple-style segmented control. Plain radio inputs + CSS.
---
<fieldset class="billing-toggle inline-flex rounded-full bg-raised p-1 text-[0.875rem]">
  <legend class="sr-only">Billing term</legend>
  <label class="cursor-pointer rounded-full px-4 py-1.5 transition-colors">
    <input type="radio" name="billing" value="annual" class="sr-only" checked /> Annual
  </label>
  <label class="cursor-pointer rounded-full px-4 py-1.5 transition-colors">
    <input type="radio" name="billing" value="monthly" class="sr-only" /> Monthly
  </label>
</fieldset>
<style>
  label:has(input:checked) { background: var(--surface); color: var(--text); font-weight: 600; box-shadow: 0 1px 4px rgb(0 0 0 / 0.12); }
  label:not(:has(input:checked)) { color: var(--text-muted); }
  label:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--accent) 70%, transparent); }
  :global(html[data-billing='monthly'] [data-term='annual']),
  :global(html:not([data-billing='monthly']) [data-term='monthly']) { display: none; }
</style>
<script>
  function bindBilling() {
    document.querySelectorAll<HTMLInputElement>('input[name="billing"]').forEach((i) => {
      i.checked = (document.documentElement.dataset.billing ?? 'annual') === i.value;
      i.onchange = () => {
        document.documentElement.dataset.billing = i.value;
        document.querySelectorAll<HTMLInputElement>(`input[name="billing"][value="${i.value}"]`).forEach((x) => (x.checked = true));
      };
    });
  }
  document.addEventListener('astro:page-load', bindBilling);
</script>
