---
// Enquiry block for quote-only and coming-soon offers. Links to the WHMCS contact form (no fake forms).
import { LINKS } from '../config/site';
interface Props { subject: string; comingSoon?: boolean }
const { subject, comingSoon = false } = Astro.props;
---
<div class="tile reveal mx-auto max-w-[61.25rem] px-8 py-14 text-center sm:px-14 sm:py-16">
  <h2 class="display-md" data-split>{comingSoon ? 'Want to know when this launches?' : 'Get a quote for your setup.'}</h2>
  <p class="lead mx-auto mt-4 max-w-xl !text-[1.1875rem]">
    {comingSoon
      ? 'Send a short note about what you need. We will reply when it is available, with confirmed pricing and limits.'
      : 'Tell us what you run, your expected traffic and any deadlines. A person from Hosttiva and Inventomo replies with a recommendation and a price.'}
  </p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
    <a href={LINKS.enquiry(subject)} class="btn btn-primary">{comingSoon ? 'Notify me' : 'Request a quote'}</a>
    <a href="/contact" class="link-more">Other ways to reach us</a>
  </div>
</div>
