---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav data-pagefind-ignore aria-label="Breadcrumb" class="font-mono text-xs text-faint">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-muted">{it.name}</span>
          : <a href={it.path} class="hover:text-text">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
