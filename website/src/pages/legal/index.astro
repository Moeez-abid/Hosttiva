---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '../../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Legal', path: '/legal' }];
const policies = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
const anyDraft = policies.some((p) => p.data.status === 'draft');
---
<Base title="Legal and policies" description="Hosttiva terms, privacy, acceptable use, refund, SLA, backup and other policies." schema={[breadcrumbs(crumbs)]} noindex={anyDraft}>
  <section class="grid-backdrop">
    <div class="container-x pb-14 pt-10 sm:pt-14">
      <Breadcrumbs items={crumbs} />
      <h1 class="display-lg mt-8" data-split="now">Legal and policies</h1>
      <p class="lead enter mt-5 max-w-2xl" style="--d:320ms">The agreements and policies that apply to Hosttiva services.</p>
      {anyDraft && (
        <p class="enter mt-6 inline-flex items-start gap-2 rounded-[var(--radius)] border border-warn/40 bg-surface px-4 py-3 text-[0.9375rem]" style="--d:440ms" role="note">
          <Icon name="TriangleAlert" size={18} class="mt-0.5 shrink-0 text-warn" />
          <span>These documents are <strong>drafts pending legal review</strong> and are not yet in effect.</span>
        </p>
      )}
    </div>
  </section>
  <section class="container-x pb-24">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {policies.map((p) => (
        <li class="reveal">
          <a href={`/legal/${p.id}`} data-tilt="4" class="tile flex h-full flex-col p-6">
            <span class="flex items-center justify-between gap-3">
              <span class="font-semibold">{p.data.title}</span>
              {p.data.status === 'draft' && <span class="badge badge-warn">Draft</span>}
            </span>
            <span class="mt-2 text-[0.9375rem] text-muted">{p.data.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
