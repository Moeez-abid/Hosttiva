---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { getProduct, type Product } from '../../data/products';
import { breadcrumbs, howTo } from '../../lib/schema';

export const getStaticPaths = (async () =>
  (await getCollection('tutorials', (t) => !t.data.draft)).map((tutorial) => ({ params: { slug: tutorial.id }, props: { tutorial } }))
) satisfies GetStaticPaths;

const { tutorial } = Astro.props;
const { Content, headings } = await render(tutorial);
const d = tutorial.data;
const path = `/tutorials/${tutorial.id}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Tutorials', path: '/tutorials' }, { name: d.title, path }];
// Numbered H2s ("1. …") are the steps.
const steps = headings
  .filter((h) => h.depth === 2 && /^\d+\.\s/.test(h.text))
  .map((h) => ({ name: h.text.replace(/^\d+\.\s*/, ''), anchor: h.slug }));
const related = d.related.map(getProduct).filter((p): p is Product => !!p);
const m = /PT(\d+)([HM])/.exec(d.totalTime)!;
const time = m[2] === 'H' ? `${m[1]} h` : `${m[1]} min`;
---
<Base title={d.title} description={d.description} ogType="article"
  schema={[breadcrumbs(crumbs), howTo({ title: d.title, description: d.description, path, totalTime: d.totalTime, requirements: d.requirements, steps })]}>
  <article class="container-x pb-20 pt-10 sm:pt-14">
    <Breadcrumbs items={crumbs} />
    <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_16rem]">
      <div class="min-w-0">
        <header class="max-w-3xl">
          <h1 class="display-lg max-w-4xl" data-split="now">{d.title}</h1>
          <p class="lead enter mt-5" style="--d:320ms">{d.description}</p>
          <p class="spec mt-6 flex flex-wrap gap-x-5 gap-y-1">
            <span class="flex items-center gap-1.5"><Icon name="Clock" size={13} />{time}</span>
            <span>{d.level}</span>
            <span>{steps.length} steps</span>
          </p>
          {d.requirements.length > 0 && (
            <div class="mt-8 tile p-6 text-[0.9375rem]">
              <p class="label mb-2">You will need</p>
              <ul class="space-y-1">{d.requirements.map((r) => <li class="flex gap-2 text-muted"><Icon name="Check" size={14} class="mt-1 shrink-0 text-link" />{r}</li>)}</ul>
            </div>
          )}
        </header>
        <div class="prose mt-12 max-w-3xl"><Content /></div>
      </div>

      <aside class="hidden lg:block">
        <nav aria-label="Steps" class="sticky top-24 text-sm">
          <p class="label mb-3">Steps</p>
          <ol class="space-y-2 border-l border-border">
            {steps.map((s, i) => (
              <li><a href={`#${s.anchor}`} class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-link hover:text-text"><span class="text-xs text-muted">{i + 1}.</span> {s.name}</a></li>
            ))}
          </ol>
          {related.length > 0 && (
            <>
              <p class="label mb-3 mt-8">Related</p>
              <ul class="space-y-2">{related.map((r) => <li><a href={`/${r.slug}`} class="text-muted hover:text-link">{r.name}</a></li>)}</ul>
            </>
          )}
        </nav>
      </aside>
    </div>
  </article>
</Base>
