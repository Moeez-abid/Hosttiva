---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ROADMAP, ROADMAP_STATUSES } from '../data/roadmap';
import { LINKS } from '../config/site';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Product Updates', path: '/roadmap' }];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const released = ROADMAP.filter((r) => r.status === 'released').sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const board = ROADMAP_STATUSES.filter((s) => s.id !== 'released');
---
<Base title="Product Updates and Roadmap" description="Follow the latest Hosttiva releases, improvements, maintenance notices, and upcoming features." schema={[breadcrumbs(crumbs)]}>
  <section class="border-b border-border">
    <div class="container-x py-14 sm:py-20">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-8">Product updates</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">What shipped, and what is next</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Follow the latest Hosttiva releases, improvements, maintenance notices, and upcoming features. Planned items have
        no dates until we are confident in them.
      </p>
    </div>
  </section>

  <div class="container-x space-y-16 py-16">
    <section aria-labelledby="board-h">
      <h2 id="board-h" class="text-2xl font-semibold">Roadmap</h2>
      <div class="mt-6 grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3">
        {board.map((s) => {
          const items = ROADMAP.filter((r) => r.status === s.id);
          return (
            <div class="bg-bg p-5">
              <p class="flex items-baseline justify-between">
                <span class="font-mono text-xs uppercase tracking-wider text-accent">{s.label}</span>
                <span class="spec !text-xs">{items.length}</span>
              </p>
              <p class="mt-1 text-xs text-faint">{s.blurb}</p>
              <ul class="mt-4 space-y-3">
                {items.map((r) => (
                  <li class="rounded-md border border-border p-3">
                    {r.href ? <a href={r.href} class="font-medium hover:text-accent">{r.title}</a> : <span class="font-medium">{r.title}</span>}
                    <p class="mt-1 text-sm text-muted">{r.detail}</p>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    <section aria-labelledby="rel-h">
      <h2 id="rel-h" class="text-2xl font-semibold">Released</h2>
      <ol class="mt-6 divide-y divide-border border-y border-border">
        {released.map((r) => (
          <li class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
            <time class="spec" datetime={r.date}>{fmt(r.date!)}</time>
            <div>
              {r.href ? <a href={r.href} class="font-medium hover:text-accent">{r.title}</a> : <span class="font-medium">{r.title}</span>}
              <p class="text-sm text-muted">{r.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="flex flex-col gap-4 rounded-lg border border-border p-6 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="fr-h">
      <div>
        <h2 id="fr-h" class="text-xl font-semibold">Feature requests</h2>
        <p class="mt-1 text-sm text-muted">Missing something? Tell us what you need and why. Requests shape what moves from planned to in development.</p>
      </div>
      <a href={LINKS.enquiry('Feature request')} class="btn btn-primary shrink-0">Suggest a feature <Icon name="ArrowRight" size={16} /></a>
    </section>
  </div>
</Base>
