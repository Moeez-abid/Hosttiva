---
// Generates every product/solution page from data/products.ts and a noindex
// placeholder for each planned page in data/pages.ts. No hand-written product pages.
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import EnquiryCta from '../components/EnquiryCta.astro';
import PlanTable from '../components/PlanTable.astro';
import BillingToggle from '../components/BillingToggle.astro';
import { PRODUCTS, CATEGORIES, CATEGORY_FAQS, getProduct, type Product } from '../data/products';
import { PLANNED_PAGES, type PlannedPage } from '../data/pages';
import { getPlanGroup } from '../data/plans';
import { LINKS, PRELAUNCH } from '../config/site';
import DnsTool from '../components/tools/DnsTool.astro';
import WhoisTool from '../components/tools/WhoisTool.astro';
import DomainGenerator from '../components/tools/DomainGenerator.astro';
import SslTool from '../components/tools/SslTool.astro';
import ProductVisual from '../components/ProductVisual.astro';
import { breadcrumbs, service, faqPage } from '../lib/schema';

export const getStaticPaths = (() => [
  ...PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } })),
  ...PLANNED_PAGES.map((planned) => ({ params: { slug: planned.slug }, props: { planned } })),
]) satisfies GetStaticPaths;

interface Props { product?: Product; planned?: PlannedPage }
const { product, planned } = Astro.props;

const clip = (s: string, n = 158) => (s.length <= n ? s : s.slice(0, s.lastIndexOf(' ', n - 1)) + '…');
---
{product ? (() => {
  const p = product;
  const path = `/${p.slug}`;
  const cat = CATEGORIES[p.category];
  const soon = p.status === 'coming-soon';
  const group = p.status === 'available' && p.planGroup ? getPlanGroup(p.planGroup) : null;
  const faqs = soon ? [] : [...(p.faqs ?? []), ...(CATEGORY_FAQS[p.category] ?? [])];
  const related = (p.related ?? []).map(getProduct).filter((r): r is Product => !!r);
  const crumbs = [{ name: 'Home', path: '/' }, { name: p.name, path }];
  const description = clip(`${p.headline} ${p.summary}`);
  const domainForm = p.slug === 'domains/search' || p.slug === 'domains/register' ? 'register' : p.slug === 'domains/transfer' ? 'transfer' : null;
  const schema = [
    breadcrumbs(crumbs),
    ...(soon ? [] : [service({ name: p.name, description, path, category: cat.label })]),
    ...(faqs.length ? [faqPage(faqs)] : []),
  ];

  return (
    <Base title={p.seoTitle ?? p.name} description={description} schema={schema}>
      <section class="grid-backdrop pt-10 sm:pt-14">
        <div class="container-x"><Breadcrumbs items={crumbs} /></div>
        <div class="container-narrow pb-16 pt-10 text-center sm:pb-20 sm:pt-16">
          <span class="icon-3d mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-raised text-link"><Icon name={p.icon} size={26} /></span>
          <h1 class="display-lg" data-split="now">{p.name}</h1>
          <p class="title enter mx-auto mt-4 max-w-2xl !font-medium" style="--d:260ms">{p.headline}</p>
          <p class="lead enter mx-auto mt-4 max-w-2xl" style="--d:380ms">{p.summary}</p>
          <div class="enter mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3" style="--d:500ms">
            {soon && <span class="badge badge-warn">Coming soon</span>}
            {group && <a href={`#plans-${group.id}`} class="btn btn-primary">See plans</a>}
            {p.status === 'enquiry' && <a href={LINKS.enquiry(p.name)} class="btn btn-primary">Request a quote</a>}
            {soon && <a href={LINKS.enquiry(`Notify me: ${p.name}`)} class="btn btn-primary">Notify me</a>}
            {!p.tool && <a href="/contact" class="link-more">Talk to an expert</a>}
          </div>

          {domainForm && (
            <form action={PRELAUNCH ? '/domains/whois' : domainForm === 'register' ? LINKS.domainSearch.split('?')[0] : LINKS.domainTransfer.split('?')[0]} method="get" class="tile-surface enter mx-auto mt-12 max-w-xl p-3 text-left" style="--d:620ms" role="search">
              {!PRELAUNCH && <><input type="hidden" name="a" value="add" /><input type="hidden" name="domain" value={domainForm} /></>}
              <label for="domain-q" class="sr-only">{domainForm === 'register' ? 'Domain to check' : 'Domain to transfer'}</label>
              <div class="flex gap-2">
                <input id="domain-q" name={PRELAUNCH ? 'q' : 'query'} type="text" required inputmode="url" autocomplete="off" spellcheck="false"
                  placeholder={domainForm === 'register' ? 'yourbrand.com' : 'example.com'} class="field" />
                <button type="submit" class="btn btn-primary shrink-0">{PRELAUNCH ? 'Check' : domainForm === 'register' ? 'Search' : 'Transfer'}</button>
              </div>
              <p class="mt-2.5 px-1 text-[0.8125rem] text-muted">{PRELAUNCH ? (domainForm === 'register' ? 'Checks whether a name is taken. Registration opens at launch.' : 'Shows the domain\'s current registration. Transfers open at launch.') : 'Continues in the Hosttiva client area.'}</p>
            </form>
          )}
        </div>
        {!p.tool && (
          <div class="container-x pb-20">
            <ProductVisual product={p} />
          </div>
        )}
        {p.tool && (
          <div class="container-x enter pb-16" style="--d:500ms">
            {p.tool === 'dns' && <DnsTool />}
            {p.tool === 'whois' && <WhoisTool />}
            {p.tool === 'generator' && <DomainGenerator />}
            {p.tool === 'ssl' && <SslTool />}
          </div>
        )}
      </section>

      {p.note && (
        <div class="container-narrow pb-12">
          <div class="tile flex gap-3 p-5 text-[0.9375rem]" role="note">
            <Icon name="Info" size={20} class={soon ? 'mt-0.5 shrink-0 text-warn' : 'mt-0.5 shrink-0 text-link'} />
            <p>{p.note}</p>
          </div>
        </div>
      )}

      {(p.features?.length || p.useCases?.length) && (
        <section class="section-alt">
          <div class="container-x py-20 sm:py-28">
            {p.features?.length && (
              <>
                <h2 class="display-md" data-split>{soon ? 'Planned features' : 'What you get'}</h2>
                <ul class="mt-10 grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
                  {p.features.map((f) => (
                    <li class="reveal flex items-start gap-3 text-[1.0625rem]"><Icon name="CircleCheck" size={20} class="mt-0.5 shrink-0 text-link" />{f}</li>
                  ))}
                </ul>
              </>
            )}
            {p.useCases?.length && (
              <p class:list={['reveal max-w-4xl text-[clamp(1.375rem,2.6vw,2rem)] font-semibold leading-[1.25] tracking-[-0.025em] text-muted', p.features?.length ? 'mt-16 border-t border-border pt-12' : '']}>
                Good for {p.useCases.map((u, i) => <><span class="text-text">{u.toLowerCase()}</span>{i < p.useCases!.length - 2 ? ', ' : i === p.useCases!.length - 2 ? ' and ' : '.'}</>)}
              </p>
            )}
          </div>
        </section>
      )}

      <div class="container-x space-y-24 py-20 sm:py-28">
        {group && (
          <div>
            <div class="mb-6 flex justify-end"><BillingToggle /></div>
            <PlanTable group={group} />
            <p class="mt-5"><a href="/pricing" class="link-more">Compare every Hosttiva plan</a></p>
          </div>
        )}

        {p.status !== 'available' && <EnquiryCta subject={p.name} comingSoon={soon} />}

        {faqs.length > 0 && <Faq faqs={faqs} />}

        {related.length > 0 && (
          <section aria-labelledby="rel-h">
            <h2 id="rel-h" class="display-md" data-split>Related</h2>
            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
              {related.map((r) => (
                <li class="reveal">
                  <a href={`/${r.slug}`} data-tilt="6" class="tile group flex h-full flex-col p-7">
                    <span class="text-link"><Icon name={r.icon} size={22} /></span>
                    <span class="title mt-4 flex items-center gap-2 !text-[1.3125rem]">{r.name}{r.status === 'coming-soon' && <span class="badge">Soon</span>}</span>
                    <span class="mt-1.5 flex-1 text-[0.9375rem] text-muted">{r.headline}</span>
                    <span class="link-more mt-5 text-[0.9375rem]">Learn more</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </Base>
  );
})() : planned && (
  <Base title={planned.title} description={planned.blurb} noindex>
    <section class="pt-10 sm:pt-14">
      <div class="container-x"><Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: planned.title, path: `/${planned.slug}` }]} /></div>
      <div class="container-narrow py-24 text-center sm:py-32">
        <span class="badge">Coming soon</span>
        <h1 class="display-lg mt-5" data-split="now">{planned.title}</h1>
        <p class="lead mx-auto mt-5 max-w-2xl">{planned.blurb}</p>
        <p class="mx-auto mt-5 max-w-xl text-[0.9375rem] text-muted">This page is being prepared and is not published yet. If you need something now, contact the team and a person will reply.</p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
          <a href="/contact" class="btn btn-primary">Contact us</a>
          <a href="/roadmap" class="link-more">See the roadmap</a>
        </div>
      </div>
    </section>
  </Base>
)}
