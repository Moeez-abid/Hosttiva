---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { TRUST_TOPICS } from '../data/trust';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Trust Center', path: '/trust' }];
const published = TRUST_TOPICS.filter((t) => t.status === 'published');
const pending = TRUST_TOPICS.filter((t) => t.status === 'pending');
---
<Base title="Trust Center" description="Security, backups, responsible disclosure and email compliance at Hosttiva, plus what we will publish about infrastructure, privacy and incident response." schema={[breadcrumbs(crumbs)]}>
  <section class="border-b border-border">
    <div class="container-x py-14 sm:py-20">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-8">Trust Center</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold sm:text-5xl">What we can show you today, and what comes next</h1>
      <p class="mt-4 max-w-2xl text-muted">
        We only publish what we can stand behind. Topics marked “Before launch” will be documented once the
        infrastructure, policies and legal review behind them are final.
      </p>
      <nav aria-label="Trust topics" class="mt-8 flex flex-wrap gap-2 text-sm">
        {TRUST_TOPICS.map((t) => (
          <a href={`#${t.id}`} class="rounded-full border border-border px-3 py-1 text-muted hover:border-accent hover:text-text">{t.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container-x py-16">
    <div class="space-y-px overflow-hidden rounded-lg border border-border bg-border">
      {published.map((t) => (
        <section id={t.id} class="scroll-mt-24 grid gap-6 bg-bg p-6 sm:p-8 md:grid-cols-[18rem_1fr]" aria-labelledby={`${t.id}-h`}>
          <div>
            <span class="text-accent"><Icon name={t.icon} size={22} /></span>
            <h2 id={`${t.id}-h`} class="mt-3 text-xl font-semibold">{t.title}</h2>
            <p class="mt-2 text-sm text-muted">{t.summary}</p>
          </div>
          <ul class="space-y-2 text-sm">
            {t.points.map((p) => <li class="flex gap-2"><Icon name="Check" size={15} class="mt-0.5 shrink-0 text-accent" />{p}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <h2 class="mt-20 text-2xl font-semibold">Before launch</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">These pages are in preparation. Each will list specifics rather than general assurances.</p>
    <ul class="mt-8 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {pending.map((t) => (
        <li id={t.id} class="scroll-mt-24 bg-bg p-5">
          <div class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-2 font-medium"><Icon name={t.icon} size={16} class="text-faint" />{t.title}</span>
            <span class="badge">Before launch</span>
          </div>
          <p class="mt-2 text-sm text-muted">{t.summary}</p>
          <ul class="spec mt-3 space-y-1 !text-xs">{t.points.map((p) => <li>· {p}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</Base>
