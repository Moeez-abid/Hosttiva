---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { TRUST_TOPICS } from '../data/trust';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Trust Center', path: '/trust' }];
const published = TRUST_TOPICS.filter((t) => t.status === 'published');
const pending = TRUST_TOPICS.filter((t) => t.status === 'pending');
---
<Base title="Trust Center" description="Security, backups, responsible disclosure and email compliance at Hosttiva, plus what we will publish about infrastructure, privacy and incident response." schema={[breadcrumbs(crumbs)]}>
  <section>
    <div class="container-x pb-16 pt-10 sm:pb-20 sm:pt-14">
      <Breadcrumbs items={crumbs} />
      <h1 class="display-lg mt-8 max-w-4xl">What we can show you today, and what comes next</h1>
      <p class="lead mt-5 max-w-2xl">
        We only publish what we can stand behind. Topics marked “Before launch” will be documented once the
        infrastructure, policies and legal review behind them are final.
      </p>
      <nav aria-label="Trust topics" class="mt-8 flex flex-wrap gap-2 text-sm">
        {TRUST_TOPICS.map((t) => (
          <a href={`#${t.id}`} class="btn btn-quiet btn-sm">{t.title}</a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container-x py-16">
    <div class="space-y-4">
      {published.map((t) => (
        <section id={t.id} class="tile reveal scroll-mt-24 grid gap-8 p-8 sm:p-10 md:grid-cols-[20rem_1fr]" aria-labelledby={`${t.id}-h`}>
          <div>
            <span class="text-link"><Icon name={t.icon} size={22} /></span>
            <h2 id={`${t.id}-h`} class="title mt-4">{t.title}</h2>
            <p class="mt-2 text-[0.9375rem] text-muted">{t.summary}</p>
          </div>
          <ul class="space-y-3 text-[1.0625rem]">
            {t.points.map((p) => <li class="flex gap-2"><Icon name="CircleCheck" size={20} class="mt-0.5 shrink-0 text-link" />{p}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <h2 class="display-md mt-24">Before launch</h2>
    <p class="lead mt-4 max-w-2xl">These pages are in preparation. Each will list specifics rather than general assurances.</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {pending.map((t) => (
        <li id={t.id} class="tile reveal scroll-mt-24 p-7">
          <div class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-2 font-medium"><Icon name={t.icon} size={16} class="text-muted" />{t.title}</span>
            <span class="badge">Before launch</span>
          </div>
          <p class="mt-2 text-sm text-muted">{t.summary}</p>
          <ul class="spec mt-4 space-y-1">{t.points.map((p) => <li>· {p}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</Base>
