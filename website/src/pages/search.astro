---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search Hosttiva products, plans, tools and articles." noindex>
  <section class="container-x py-14 sm:py-20">
    <p class="eyebrow">Search</p>
    <h1 class="mt-3 text-4xl font-semibold">Search Hosttiva</h1>
    <div id="search" class="mt-8 max-w-3xl"></div>
    <noscript><p class="mt-6 text-muted">Search needs JavaScript. You can browse <a class="link" href="/pricing">plans</a> or the <a class="link" href="/blog">blog</a> instead.</p></noscript>
  </section>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    function initSearch() {
      var el = document.getElementById('search');
      if (!el || el.dataset.ready || typeof PagefindUI === 'undefined') return;
      el.dataset.ready = '1';
      var ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
      var q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    }
    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>
  <style is:global>
    #search {
      --pagefind-ui-primary: var(--accent);
      --pagefind-ui-text: var(--text);
      --pagefind-ui-background: var(--bg-raised);
      --pagefind-ui-border: var(--border-strong);
      --pagefind-ui-tag: var(--bg-sunken);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 8px;
      --pagefind-ui-font: var(--font-sans);
    }
    #search .pagefind-ui__result-excerpt { color: var(--text-muted); }
    #search mark { background: var(--accent-soft); color: var(--text); }
  </style>
</Base>
