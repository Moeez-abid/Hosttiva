---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BRAND, VALUES, AUDIENCES, ECOSYSTEM, WHY_CHOOSE } from '../data/brand';
import { SITE } from '../config/site';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Our Story', path: '/about' }];
const schema = [
  breadcrumbs(crumbs),
  { '@type': 'AboutPage', name: 'About Hosttiva by Inventomo', url: `${SITE.url}/about`, about: { '@id': `${SITE.url}/#organization` } },
];
---
<Base title="Our Story" description="Meet the people, technology, and vision behind Hosttiva by Inventomo: the hosting and cloud division of Inventomo." schema={schema}>
  <section class="pt-10 sm:pt-14">
    <div class="container-x"><Breadcrumbs items={crumbs} /></div>
    <div class="container-narrow py-20 text-center sm:py-28">
      <h1 class="display-xl">Hosttiva hosts your technology.<br /><span class="text-muted">Inventomo helps you create it.</span></h1>
      <p class="lead mx-auto mt-8 max-w-3xl">{BRAND.positioning}</p>
    </div>
  </section>

  <section class="section-alt" aria-labelledby="mission-h">
    <div class="container-narrow space-y-20 py-24 sm:py-32">
      <div class="reveal">
        <h2 id="mission-h" class="text-[1.3125rem] font-semibold text-muted">Our mission</h2>
        <p class="display-md mt-4 !font-semibold">{BRAND.mission}</p>
      </div>
      <div class="reveal">
        <h2 class="text-[1.3125rem] font-semibold text-muted">Our vision</h2>
        <p class="display-md mt-4 !font-semibold">{BRAND.vision}</p>
      </div>
    </div>
  </section>

  <section class="section-inverse" aria-labelledby="promise-h">
    <div class="container-x py-24 sm:py-32">
      <h2 id="promise-h" class="display-lg reveal max-w-4xl">{BRAND.promise}</h2>
      <ul class="mt-14 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {BRAND.promiseLines.map((l) => (
          <li class="reveal border-t border-white/15 pt-6 text-[1.5rem] font-semibold leading-tight tracking-[-0.025em]">{l}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-x py-24 sm:py-32" aria-labelledby="values-h">
    <h2 id="values-h" class="display-lg reveal max-w-3xl">What we hold ourselves to.</h2>
    <dl class="mt-14 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-3">
      {VALUES.map((v) => (
        <div class="reveal border-t border-border py-7">
          <dt class="title">{v.name}</dt>
          <dd class="mt-2 text-muted">{v.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section-alt" aria-labelledby="eco-h">
    <div class="container-x grid gap-14 py-24 sm:py-32 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <h2 id="eco-h" class="display-lg reveal">One partner, from first domain to custom platform.</h2>
        <p class="lead reveal mt-6 max-w-xl">{BRAND.usp}</p>
      </div>
      <nav aria-label="Hosttiva ecosystem" class="reveal">
        <ul class="divide-y divide-border border-y border-border">
          {ECOSYSTEM.map((e) => (
            <li><a href={e.href} class="flex items-center justify-between py-3.5 text-[1.3125rem] font-semibold tracking-tight hover:text-link">{e.name}<Icon name="ChevronRight" size={18} class="text-muted" /></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="container-narrow py-24 sm:py-32" aria-labelledby="why-h">
    <p class="reveal text-[clamp(1.5rem,3.2vw,2.5rem)] font-semibold leading-[1.2] tracking-[-0.03em] text-muted">
      Made for
      {AUDIENCES.map((a, i) => (
        <><span class="text-text">{a.name.toLowerCase()}</span>{i < AUDIENCES.length - 2 ? ', ' : i === AUDIENCES.length - 2 ? ' and ' : '.'}</>
      ))}
    </p>
    <h2 id="why-h" class="display-md reveal mt-20">{BRAND.finalStatement}</h2>
    <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2">
      {WHY_CHOOSE.map((w) => (
        <li class="reveal flex items-start gap-3 text-[1.0625rem]"><Icon name="CircleCheck" size={20} class="mt-0.5 shrink-0 text-link" />{w}</li>
      ))}
    </ul>
    <div class="mt-14 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/pricing" class="btn btn-primary">See plans</a>
      <a href="/contact" class="link-more">Talk to the team</a>
    </div>
  </section>
</Base>
