---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PlanTable from '../components/PlanTable.astro';
import BillingToggle from '../components/BillingToggle.astro';
import Faq from '../components/Faq.astro';
import { productsIn, getProduct, CATEGORY_FAQS } from '../data/products';
import { getPlanGroup } from '../data/plans';
import { LINKS } from '../config/site';
import { breadcrumbs, faqPage } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'For Agencies', path: '/agencies' }];
const items = [...productsIn('agencies'), getProduct('solutions/reseller')!];
const faqs = CATEGORY_FAQS.agencies ?? [];
---
<Base
  title="For Agencies"
  description="Manage client websites, sell hosting, earn referral rewards, join the partner network, or ask Inventomo to build a custom digital solution."
  schema={[breadcrumbs(crumbs), faqPage(faqs)]}
>
  <section class="grid-backdrop">
    <div class="container-x pb-16 pt-10 sm:pb-20 sm:pt-14">
      <Breadcrumbs items={crumbs} />
      <h1 class="display-lg mt-8 max-w-4xl" data-split="now">Grow your agency with Hosttiva</h1>
      <p class="lead enter mt-5 max-w-2xl" style="--d:320ms">
        Manage client websites, sell hosting, earn referral rewards, join our partner network, or ask Inventomo to build
        a custom digital solution for your business.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/agencies/hosting" class="btn btn-primary">Explore agency hosting <Icon name="ArrowRight" size={16} /></a>
        <a href="/agencies/affiliate" class="btn btn-secondary">Join the affiliate program</a>
        <a href={LINKS.enquiry('Agency custom build')} class="btn btn-secondary">Ask Inventomo to build it</a>
      </div>
    </div>
  </section>

  <div class="container-x space-y-20 py-16">
    <section aria-labelledby="tools-h">
      <h2 id="tools-h" class="display-md" data-split>Everything in the agency toolkit</h2>
      <ul class="mt-6 divide-y divide-border border-y border-border" data-stagger>
        {items.map((p) => (
          <li class="reveal">
            <a href={`/${p.slug}`} class="group grid items-center gap-4 py-5 sm:grid-cols-[2rem_14rem_1fr_auto]">
              <span class="text-link"><Icon name={p.icon} size={20} /></span>
              <span class="font-medium">{p.name}</span>
              <span class="text-sm text-muted">{p.headline}</span>
              <span class="flex items-center gap-2">
                {p.status === 'coming-soon' && <span class="badge">Soon</span>}
                <Icon name="ArrowRight" size={16} class="text-muted transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div>
      <div class="mb-4 flex justify-end"><BillingToggle /></div>
      <PlanTable group={getPlanGroup('agency')} />
    </div>

    <Faq faqs={faqs} title="Agency questions" />
  </div>
</Base>
