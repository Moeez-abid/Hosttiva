---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { PRODUCTS, CATEGORIES, PRODUCT_CATEGORIES, type CategoryId } from '../data/products';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Sitemap', path: '/sitemap' }];
const live = PRODUCTS.filter((p) => p.status !== 'coming-soon');
const cats: CategoryId[] = [...PRODUCT_CATEGORIES, 'solutions'];
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const company = [
  { label: 'Home', href: '/' }, { label: 'Pricing', href: '/pricing' }, { label: 'Marketplace', href: '/marketplace' },
  { label: 'For Agencies', href: '/agencies' }, { label: 'Our Story', href: '/about' }, { label: 'Trust Center', href: '/trust' },
  { label: 'Contact', href: '/contact' }, { label: 'Customer Success', href: '/customer-success' }, { label: 'Blog', href: '/blog' }, { label: 'Tutorials', href: '/tutorials' },
  { label: 'Product Updates', href: '/roadmap' }, { label: 'Legal', href: '/legal' }, { label: 'Search', href: '/search' },
];
---
<Base title="Sitemap" description="Every page on the Hosttiva by Inventomo website, grouped by section." schema={[breadcrumbs(crumbs)]}>
  <section class="container-x py-14 sm:py-20">
    <Breadcrumbs items={crumbs} />
    <h1 class="display-lg mt-8" data-split="now">Sitemap</h1>
    <p class="mt-3 text-muted">Looking for the XML version? It is at <a class="link text-sm" href="/sitemap-index.xml">/sitemap-index.xml</a>.</p>

    <div class="mt-12 columns-1 gap-10 sm:columns-2 lg:columns-3">
      <nav aria-label="Company" class="mb-10 break-inside-avoid">
        <h2 class="mb-3 text-[0.875rem] font-semibold">Company</h2>
        <ul class="space-y-1.5 text-sm">{company.map((l) => <li><a href={l.href} class="text-muted hover:text-text">{l.label}</a></li>)}</ul>
      </nav>
      {cats.map((c) => (
        <nav aria-label={CATEGORIES[c].label} class="mb-10 break-inside-avoid">
          <h2 class="mb-3 text-[0.875rem] font-semibold">{CATEGORIES[c].label}</h2>
          <ul class="space-y-1.5 text-sm">
            {live.filter((p) => p.category === c).map((p) => <li><a href={`/${p.slug}`} class="text-muted hover:text-text">{p.name}</a></li>)}
          </ul>
        </nav>
      ))}
      <nav aria-label="Blog" class="mb-10 break-inside-avoid">
        <h2 class="mb-3 text-[0.875rem] font-semibold">Blog</h2>
        <ul class="space-y-1.5 text-sm">{posts.map((p) => <li><a href={`/blog/${p.id}`} class="text-muted hover:text-text">{p.data.title}</a></li>)}</ul>
      </nav>
    </div>
  </section>
</Base>
