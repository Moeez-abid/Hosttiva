---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SITE } from '../config/site';
import { NOINDEX_PATHS } from '../config/noindex';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
}

const { title, description, schema = [], ogImage = SITE.ogImage, ogType = 'website' } = Astro.props;
// build.format 'file' makes pathname end in .html during the build; canonical URLs never do.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const noindex = Astro.props.noindex ?? NOINDEX_PATHS.includes(path);
const canonical = new URL(path, SITE.url).toString();
const fullTitle = path === '/' ? `${SITE.fullName} — ${SITE.tagline}` : `${title} | ${SITE.fullName}`;
const ogImageUrl = new URL(ogImage, SITE.url).toString();
---
<!doctype html>
<html lang={SITE.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a0f17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

    <script is:inline>
      function applyTheme() {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter fallback="swap" />
    <JsonLd data={[organization(), website(), ...schema]} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header />
    <main id="main" class="flex-1" data-pagefind-body={noindex ? undefined : true}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
