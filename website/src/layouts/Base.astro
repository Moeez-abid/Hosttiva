---
// SF Pro renders on Apple devices; Inter (optical sizes) is the self-hosted fallback elsewhere.
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SITE } from '../config/site';
import { NOINDEX_PATHS } from '../config/noindex';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
}

const { title, description, schema = [], ogImage = SITE.ogImage, ogType = 'website' } = Astro.props;
// build.format 'file' makes pathname end in .html during the build; canonical URLs never do.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const noindex = Astro.props.noindex ?? NOINDEX_PATHS.includes(path);
const canonical = new URL(path, SITE.url).toString();
const fullTitle = path === '/' ? `${SITE.fullName} — ${SITE.tagline}` : `${title} | ${SITE.fullName}`;
const ogImageUrl = new URL(ogImage, SITE.url).toString();
// Page-to-page motion: the old page lifts away, the new one rises in (keyframes in global.css).
const pageTransition = {
  forwards: {
    old: { name: 'page-out', duration: '220ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in', duration: '520ms', delay: '60ms', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-out', duration: '220ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in', duration: '520ms', delay: '60ms', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
};
---
<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

    <script is:inline>
      function applyTheme() {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
      // Arm the motion system only when motion is allowed; failsafe un-arms it if the script never runs.
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var h = document.documentElement;
        h.classList.add('motion');
        setTimeout(function () { if (!window.__motion) h.classList.remove('motion'); }, 3000);
      })();
      document.addEventListener('astro:after-swap', function () {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      });
    </script>
    <ClientRouter fallback="swap" />
    <JsonLd data={[organization(), website(), ...schema]} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Fragment set:html={`<!--
THESIS: Hosting explained the way Apple sells hardware: one product line per moment, huge plain type, the real numbers (first-term and renewal price) shown as the hero object; refuses the dark-dashboard, neon-accent hosting page.
OWN-WORLD: White and #f5f5f7 grounds (black/#161617 in dark), #1d1d1f ink, Apple system blue #0071e3 as the only accent, SF Pro / Inter optical sizes, 18-28px radii, pill buttons, glass only on nav, flyouts and floating panels.
STORY: Visitor learns what Hosttiva sells, sees honest renewal pricing, picks a product line, then orders in the client area or enquires.
FIRST VIEWPORT: Centred display headline and subhead, blue pill + text link, then a glass plan panel and DNS panel floating over an authored server-rack illustration.
FORM: Pinned brief (Apple canon) over roll; seed key c5c5042b.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />
    <Header />
    <main id="main" class="flex-1" data-pagefind-body={noindex ? undefined : true} transition:animate={pageTransition}>
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from '../lib/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
